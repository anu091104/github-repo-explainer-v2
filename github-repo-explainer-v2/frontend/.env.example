# LOCAL: points at your local backend.
# VERCEL: set VITE_API_BASE_URL in Project Settings -> Environment Variables
# to your Render backend URL (e.g. https://repo-explainer-api.onrender.com),
# with NO trailing slash. Vite bakes it in at BUILD time, so redeploy after changing it.
VITE_API_BASE_URL=http://localhost:8000

# Optional: where the sidebar's "View source" link points.
VITE_REPO_URL=https://github.com/anu091104
